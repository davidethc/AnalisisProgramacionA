0:14:35-0500","results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>coolumnas tipos</h2>\n\n</div>"}]}},{"text":"val columnasNumericas = ENV_copia.schema.fields\n  .filter(field => field.dataType.typeName == \"double\")\n  .map(_.name)\n\nprintln(\"Columnas numéricas:\")\ncolumnasNumericas.foreach(println)\n\nval columnasTexto = ENV_copia.schema.fields\n  .filter(field => field.dataType.typeName == \"string\")\n  .map(_.name)\n  println(\"\")\nprintln(\"--------\")\nprintln(\"\")\nprintln(\"Columnas de texto:\")\ncolumnasTexto.foreach(println)\n","user":"anonymous","dateUpdated":"2025-07-09T20:14:40-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752110076440_920610436","id":"paragraph_1752110076440_920610436","dateCreated":"2025-07-09T20:14:36-0500","status":"FINISHED","focus":false,"dateFinished":"2025-07-09T20:14:40-0500","dateStarted":"2025-07-09T20:14:40-0500","results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Columnas numéricas:\nTemperature (C)\nApparent Temperature (C)\nHumidity\nWind Speed (km/h)\nWind Bearing (degrees)\nVisibility (km)\nLoud Cover\nPressure (millibars)\n\n--------\n\nColumnas de texto:\nSummary\nPrecip Type\nDaily Summary\n\u001b[1m\u001b[34mcolumnasNumericas\u001b[0m: \u001b[1m\u001b[32mArray[String]\u001b[0m = Array(Temperature (C), Apparent Temperature (C), Humidity, Wind Speed (km/h), Wind Bearing (degrees), Visibility (km), Loud Cover, Pressure (millibars))\n\u001b[1m\u001b[34mcolumnasTexto\u001b[0m: \u001b[1m\u001b[32mArray[String]\u001b[0m = Array(Summary, Precip Type, Daily Summary)\n"}]}},{"user":"anonymous","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752109584348_546302125","id":"paragraph_1752109584348_546302125","dateCreated":"2025-07-09T20:06:24-0500","status":"FINISHED","text":"%md\n## Ver cantidad de filas nulas por columna","focus":false,"dateUpdated":"2025-07-09T20:06:30-0500","dateFinished":"2025-07-09T20:06:30-0500","dateStarted":"2025-07-09T20:06:30-0500","results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>Ver cantidad de filas nulas por columna</h2>\n\n</div>"}]}},{"text":"val columnas = ENV_copia.columns\ncolumnas.foreach { col =>\n  val nulos = ENV_copia.filter(ENV_copia(col).isNull || ENV_copia(col) === \"\").count()\n  println(s\"Columna: $col → Nulos: $nulos\")\n}\n\n","user":"anonymous","dateUpdated":"2025-07-09T20:06:44-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=109"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=110"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=111"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=112"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=113"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=114"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=115"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=116"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=117"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=118"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=119"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=120"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=121"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=122"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=123"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=124"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=125"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=126"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=127"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=128"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=129"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=130"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=131"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=132"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752109597378_1124683920","id":"paragraph_1752109597378_1124683920","dateCreated":"2025-07-09T20:06:37-0500","status":"FINISHED","focus":false,"dateFinished":"2025-07-09T20:06:47-0500","dateStarted":"2025-07-09T20:06:44-0500","results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"Columna: Formatted Date → Nulos: 0\nColumna: Summary → Nulos: 0\nColumna: Precip Type → Nulos: 0\nColumna: Temperature (C) → Nulos: 0\nColumna: Apparent Temperature (C) → Nulos: 0\nColumna: Humidity → Nulos: 0\nColumna: Wind Speed (km/h) → Nulos: 0\nColumna: Wind Bearing (degrees) → Nulos: 0\nColumna: Visibility (km) → Nulos: 0\nColumna: Loud Cover → Nulos: 0\nColumna: Pressure (millibars) → Nulos: 0\nColumna: Daily Summary → Nulos: 0\n\u001b[1m\u001b[34mcolumnas\u001b[0m: \u001b[1m\u001b[32mArray[String]\u001b[0m = Array(Formatted Date, Summary, Precip Type, Temperature (C), Apparent Temperature (C), Humidity, Wind Speed (km/h), Wind Bearing (degrees), Visibility (km), Loud Cover, Pressure (millibars), Daily Summary)\n"}]}},{"user":"anonymous","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752110160352_65348094","id":"paragraph_1752110160352_65348094","dateCreated":"2025-07-09T20:16:00-0500","status":"FINISHED","text":"%md \n## valores distintos de cada columna ","focus":false,"dateUpdated":"2025-07-09T20:16:12-0500","dateFinished":"2025-07-09T20:16:12-0500","dateStarted":"2025-07-09T20:16:12-0500","results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h2>valores distintos de cada columna</h2>\n\n</div>"}]}},{"text":"import org.apache.spark.sql.types.StringType\n\nval stringCols = ENV_copia.schema.fields\n  .filter(f => f.dataType == StringType)\n  .map(_.name)\n\nstringCols.foreach { colName =>\n  println(s\"\\n=== Valores distintos para '$colName' ===\")\n  ENV_copia.select(col(colName))\n    .distinct()\n    .show(20, truncate=false)\n}\n\n","user":"anonymous","dateUpdated":"2025-07-09T20:16:18-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=152"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=153"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=154"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=155"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=156"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=157"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752110173273_63303497","id":"paragraph_1752110173273_63303497","dateCreated":"2025-07-09T20:16:13-0500","status":"FINISHED","focus":false,"dateFinished":"2025-07-09T20:16:20-0500","dateStarted":"2025-07-09T20:16:18-0500","results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"\n=== Valores distintos para 'Summary' ===\n+-----------------------------------+\n|Summary                            |\n+-----------------------------------+\n|Breezy                             |\n|Humid and Mostly Cloudy            |\n|Windy and Overcast                 |\n|Foggy                              |\n|Humid and Partly Cloudy            |\n|Windy and Foggy                    |\n|Breezy and Partly Cloudy           |\n|Dry                                |\n|Partly Cloudy                      |\n|Clear                              |\n|Mostly Cloudy                      |\n|Breezy and Foggy                   |\n|Breezy and Overcast                |\n|Dangerously Windy and Partly Cloudy|\n|Breezy and Mostly Cloudy           |\n|Windy and Partly Cloudy            |\n|Windy                              |\n|Dry and Partly Cloudy              |\n|Windy and Mostly Cloudy            |\n|Overcast                           |\n+-----------------------------------+\nonly showing top 20 rows\n\n\n=== Valores distintos para 'Precip Type' ===\n+-----------+\n|Precip Type|\n+-----------+\n|rain       |\n|snow       |\n|null       |\n+-----------+\n\n\n=== Valores distintos para 'Daily Summary' ===\n+-------------------------------------------------------------------------------------------------------------------+\n|Daily Summary                                                                                                      |\n+-------------------------------------------------------------------------------------------------------------------+\n|Foggy until night.                                                                                                 |\n|Partly cloudy overnight.                                                                                           |\n|Partly cloudy throughout the day and breezy in the evening.                                                        |\n|Partly cloudy in the afternoon.                                                                                    |\n|Clear throughout the day.                                                                                          |\n|Breezy starting overnight continuing until afternoon and mostly cloudy starting overnight continuing until evening.|\n|Foggy overnight.                                                                                                   |\n|Partly cloudy throughout the day.                                                                                  |\n|Mostly cloudy starting overnight continuing until evening and breezy starting overnight continuing until morning.  |\n|Mostly cloudy starting overnight continuing until evening.                                                         |\n|Foggy in the morning.                                                                                              |\n|Partly cloudy throughout the day and breezy starting in the morning continuing until evening.                      |\n|Foggy starting overnight continuing until night.                                                                   |\n|Partly cloudy until evening and breezy in the morning.                                                             |\n|Mostly cloudy throughout the day.                                                                                  |\n|Mostly cloudy starting in the morning continuing until night.                                                      |\n|Breezy and partly cloudy in the afternoon.                                                                         |\n|Partly cloudy until night and breezy starting in the morning continuing until afternoon.                           |\n|Mostly cloudy starting in the afternoon continuing until night.                                                    |\n|Mostly cloudy until night.                                                                                         |\n+--------------------------------------------------------