:47:45-0500","dateFinished":"2025-07-09T19:47:45-0500","status":"FINISHED"},{"text":" %md\n # Conteo de registros por presión atmosférica agrupada en rangos (bins)","user":"anonymous","dateUpdated":"2025-07-09T19:48:37-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h1>Conteo de registros por presión atmosférica agrupada en rangos (bins)</h1>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752108393054_1250846148","id":"paragraph_1752108393054_1250846148","dateCreated":"2025-07-09T19:46:33-0500","dateStarted":"2025-07-09T19:48:37-0500","dateFinished":"2025-07-09T19:48:37-0500","status":"FINISHED"},{"text":"val minPress = ENV_copia.agg(min(\"Pressure (millibars)\")).first().getDouble(0)\nval maxPress = ENV_copia.agg(max(\"Pressure (millibars)\")).first().getDouble(0)\nval binWidthPress = (maxPress - minPress) / 10\n\nval histPress = ENV_copia\n  .withColumn(\"press_bin\", (($\"Pressure (millibars)\" - minPress) / binWidthPress).cast(\"int\"))\n  .groupBy(\"press_bin\")\n  .count()\n  .orderBy(\"press_bin\")\n\nz.show(histPress)\n","user":"anonymous","dateUpdated":"2025-07-09T19:49:07-0500","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{"0":{"graph":{"mode":"multiBarChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false}},"keys":[{"name":"press_bin","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true,"editorSetting":{"language":"scala","editOnDblClick":false,"completionKey":"TAB","completionSupport":true}},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","dat