52095_1384688029","dateCreated":"2025-07-09T19:34:12-0500","dateStarted":"2025-07-09T19:42:38-0500","dateFinished":"2025-07-09T19:42:40-0500","status":"FINISHED"},{"text":"%md\n# Histograma aproximado para Temperatura (C) agrupando en 10 bins","user":"anonymous","dateUpdated":"2025-07-09T19:43:09-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h1>Histograma aproximado para Temperatura (C) agrupando en 10 bins</h1>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752108129253_282230127","id":"paragraph_1752108129253_282230127","dateCreated":"2025-07-09T19:42:09-0500","dateStarted":"2025-07-09T19:43:09-0500","dateFinished":"2025-07-09T19:43:11-0500","status":"FINISHED"},{"text":"import org.apache.spark.sql.functions._\n\nval minTemp = ENV_copia.agg(min(\"Temperature (C)\")).first().getDouble(0)\nval maxTemp = ENV_copia.agg(max(\"Temperature (C)\")).first().getDouble(0)\nval binWidth = (maxTemp - minTemp) / 10\n\nval histTemp = ENV_copia\n  .withColumn(\"temp_bin\", (($\"Temperature (C)\" - minTemp) / binWidth).cast(\"int\"))\n  .groupBy(\"temp_bin\")\n  .count()\n  .orderBy(\"temp_bin\")\n\nz.show(histTemp)\n","user":"anonymous","dateUpdated":"2025-07-09T20:00:17-0500","progress":20,"config":{"tableHide":false,"editorSetting":{"language":"scala","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"},"colWidth":12,"fontSize":9,"editorHide":false,"results":{"0":{"graph":{"mode":"stackedAreaChart","height":300,"optionOpen":false,"setting":{"multiBarChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","stacked":false},"lineChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","forceY":false,"lineWithFocus":false,"isDateFormat":false,"dateFormat":""},"stackedAreaChart":{"rotate":{"degree":"-45"},"xLabelStatus":"default","style":"stack"}},"keys":[{"name":"temp_bin","index":0,"aggr":"sum"}],"groups":[],"values":[{"name":"count","index":1,"aggr":"sum"}]}}},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"TABLE","data":"temp_bin\tcount\n0\t54\n1\t494\n2\t3550\n3\t15397\n4\t20497\n5\t20322\n6\t19286\n7\t11334\n8\t4833\n9\t685\n10\t1\n"},{"type":"TEXT","data":"import org.apache.spark.sql.functions._\n\u001b[1m\u001b[34mminTemp\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = -21.822222222222223\n\u001b[1m\u001b[34mmaxTemp\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 39.90555555555555\n\u001b[1m\u001b[34mbinWidth\u001b[0m: \u001b[1m\u001b[32mDouble\u001b[0m = 6.172777777777777\n\u001b[1m\u001b[34mhistTemp\u001b[0m: \u001b[1m\u001b[32morg.apache.spark.sql.Dataset[org.apache.spark.sql.Row]\u001b[0m = [temp_bin: int, count: bigint]\n"}]},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=70"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=71"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=72"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=73"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=74"},{"jobUrl":"http://172.17.187.23:4040/jobs/job?id=75"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752108189121_470069024","id":"paragraph_1752108189121_470069024","dateCreated":"2025-07-09T19:43:09-0500","dateStarted":"2025-07-09T19:44:16-0500","dateFinished":"2025-07-09T19:44:18-0500","status":"FINISHED"},{"text":" %md\n # Promedio de temperatura por día (serie temporal)","user":"anonymous","dateUpdated":"2025-07-09T19:48:03-0500","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth